# ==========================================
# CẤU HÌNH DÀNH CHO FRONTEND (REACT/VITE)
# ==========================================
# URL của Backend API (Mặc định là localhost:8080)
VITE_API_URL=http://localhost:8080

# ==========================================
# CẤU HÌNH DÀNH CHO BACKEND (SPRING BOOT)
# ==========================================
# Nếu chạy Backend bằng IntelliJ/Eclipse, bạn có thể thiết lập các biến này trong Run Configuration
# Nếu chạy bằng Docker, nó sẽ tự đọc các biến này.

# Database
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=careerfit_db;integratedSecurity=true;encrypt=false;trustServerCertificate=true

# JWT Secret (Bắt buộc phải dài ít nhất 32 ký tự / 256 bits)
JWT_SECRET=CareerFitSWP391SecretKeyMustBe256BitsLongForHS256AlgorithmDevDefault

# Frontend URL (Dành cho CORS)
FRONTEND_URL=http://localhost:5173

# Cấu hình Đăng nhập Google (Tùy chọn)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cấu hình Đăng nhập Microsoft (Tùy chọn)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
